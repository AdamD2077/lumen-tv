# Lumen TV session. sway is only the window plumbing here: the launcher lives
# on workspace "home" and every app gets its own workspace, so each one fills
# the screen and "home" is just a workspace switch.

default_border none
default_floating_border none
focus_follows_mouse no
mouse_warping none
focus_on_window_activation focus
workspace_auto_back_and_forth no

output * bg #090c11 solid_color
seat * hide_cursor 3000
seat * hide_cursor when-typing enable

workspace home
for_window [app_id="tv.lumen.shell"] move container to workspace home
# Android's window can appear late; keep it off the launcher's workspace.
for_window [app_id="(?i)^waydroid"] move container to workspace android

# Keyboard / remote keys
bindsym XF86HomePage workspace home
bindsym Mod4+h workspace home
bindsym Mod4+q exec lumenctl close
bindsym Mod4+k exec lumenctl osk toggle
bindsym Mod4+Shift+e exit
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Both restart if they exit, which is also how an update takes effect.
exec sh -c 'while :; do lumen-input; sleep 1; done'
exec sh -c 'while :; do lumen-shell; sleep 1; done'
# Web remote; it only listens while Settings > Remote access is on.
exec sh -c 'while :; do lumen-remote; sleep 5; done'
exec udiskie --no-notify

# pi-gen configuration for the Lumen TV image
IMG_NAME=lumen-tv
TARGET_HOSTNAME=lumen
STAGE_LIST="stage0 stage1 stage2 stage-lumen"
DEPLOY_COMPRESSION=xz

# The TV session auto-logs in as this user. SSH is off, so the password only
# matters at the console; change it with `passwd` if you enable SSH.
FIRST_USER_NAME=tv
FIRST_USER_PASS=lumen
DISABLE_FIRST_BOOT_USER_RENAME=1
ENABLE_SSH=0

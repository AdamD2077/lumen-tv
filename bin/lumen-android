#!/bin/bash
# Android (Waydroid) helper used by the launcher.
#   lumen-android ensure          start Android and wait until it has booted
#   lumen-android stop            stop Android to free memory
#   lumen-android install FILE    install an APK
#   lumen-android setup [--gapps] download and initialise the Android image
set -u

die() { echo "$*" >&2; exit 1; }

session_running() { waydroid status 2>/dev/null | grep -q '^Session:[[:space:]]*RUNNING'; }

ensure() {
    command -v waydroid >/dev/null || die "Android support is not installed"
    [ -e /var/lib/waydroid/waydroid.cfg ] || die "Android is not set up yet (Settings > Android)"
    # Android needs 4K memory pages; a Pi 5 boots a 16K kernel unless told otherwise.
    [ "$(getconf PAGESIZE)" = 4096 ] || die "Android needs the 4K-page kernel: reboot to apply"

    if ! session_running; then
        setsid waydroid session start >/dev/null 2>&1 &
        for _ in $(seq 60); do
            session_running && break
            sleep 1
        done
        session_running || die "Android session did not start"
    fi
    for _ in $(seq 90); do
        if [ "$(waydroid prop get sys.boot_completed 2>/dev/null | tail -n1)" = 1 ]; then
            # One full-screen Android window rather than one window per app.
            waydroid prop set persist.waydroid.multi_windows false >/dev/null 2>&1
            return 0
        fi
        sleep 1
    done
    die "Android took too long to start"
}

case "${1:-}" in
    ensure)  ensure ;;
    stop)    waydroid session stop ;;
    install) [ -f "${2:-}" ] || die "No such file: ${2:-}"
             ensure && waydroid app install "$2" ;;
    setup)   shift
             sudo -n "$(dirname "$(readlink -f "$0")")/lumen-android-setup" "$@" \
                 || die "Android setup failed (see /var/log/lumen-android-setup.log)" ;;
    *)       die "usage: lumen-android ensure|stop|install FILE|setup [--gapps]" ;;
esac
